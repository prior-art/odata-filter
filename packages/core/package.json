{
  "name": "@odata-filter/core",
  "version": "1.5.0",
  "license": "MIT",
  "keywords": [
    "odata",
    "rest-api",
    "nodejs",
    "typescript"
  ],
  "description": "A query filter parser implementing the OData standard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prior-art/odata-filter.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/prior-art/odata-filter/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist node_modules reports coverage",
    "lint": "eslint -c ../../eslint.config.js",
    "lint:fix": "eslint -c ../../eslint.config.js --fix",
    "test": "vitest -c ../../vitest.config.ts run",
    "test:mutation": "stryker run ../../stryker.config.json",
    "test:watch": "vitest -c ../../vitest.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  }
